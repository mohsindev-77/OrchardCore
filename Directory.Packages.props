<Project>
  <!--
    PINNED ORCHARD CORE VERSION.
    Recorded in docs/adr/0001-orchard-core-version.md.
    Orchard Core 3.0.1 requires .NET 10 (confirmed on NuGet, 30 Sep 2026).
    Every API in the specification must be verified against the version pinned here.
  -->
  <PropertyGroup>
    <OrchardCoreVersion>3.0.1</OrchardCoreVersion>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="OrchardCore.Application.Cms.Targets" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Module.Targets" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Theme.Targets" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.ContentManagement" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.ContentTypes.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Data.YesSql" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Workflows.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Recipes.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Security" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Localization.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Localization" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Infrastructure.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.DisplayManagement" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Navigation.Core" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.ContentManagement.Display" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.ResourceManagement" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Admin.Abstractions" Version="$(OrchardCoreVersion)" />
    <!-- NLog file logging for the host, so an error survives past the console. See ADR note in
         WorkMate.Web's Program.cs for why this is wired at the host rather than per-module. -->
    <PackageVersion Include="OrchardCore.Logging.NLog" Version="$(OrchardCoreVersion)" />
    <!--
      Referenced by WorkMate.Dimensions for TitlePartSettings. Specification section 4 requires
      TitlePart bound to NameEn on every generated dimension content type, and in 3.0.1 that
      binding is expressed as TitlePartSettings.Pattern with TitlePartOptions.GeneratedDisabled.
      The feature itself is already enabled by the base recipe.
    -->
    <PackageVersion Include="OrchardCore.ContentFields" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Title" Version="$(OrchardCoreVersion)" />
    <!--
      Referenced by WorkMate.Records for BagPart and BagPartSettings, which carry the six standard
      employee sections. Verified against the pinned version with tools/api-probe: BagPart is
      OrchardCore.Flows.Models.BagPart in OrchardCore.Flows.Core, and BagPartSettings is what
      restricts a bag to one contained content type. The OrchardCore.Flows feature is enabled by
      recipes/base.recipe.json, without which the part definition does not exist on the tenant.
    -->
    <PackageVersion Include="OrchardCore.Flows.Core" Version="$(OrchardCoreVersion)" />
    <!--
      Test-only. OrchardCore.Settings gives tests the concrete ISite implementation; the rest
      declare the Permission constants the base recipe names, so that a permission name in a
      recipe is checked against the pinned version rather than trusted. The Roles recipe step
      ignores a name it does not recognise without warning, which makes a typo invisible.
    -->
    <PackageVersion Include="OrchardCore.Settings" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Roles.Core" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Users.Core" Version="$(OrchardCoreVersion)" />
    <!-- IUserService, for the integration suite's second, deliberately under-permissioned test user. -->
    <PackageVersion Include="OrchardCore.Users.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Deployment.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Deployment.Core" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.AuditTrail.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Features" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Roles.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The browser suite only: drives a real Chromium against a real Kestrel server. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />

    <!-- Security overrides for packages Orchard Core pulls in (NuGet audit, 30 Sep 2026) -->
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />

    <!--
      YesSql is not pinned directly; Orchard Core pins it transitively, and these versions are the
      ones OrchardCore.Data.YesSql 3.0.1 declares in its nuspec. They are named here only so the
      dimension engine's date round-trip test can open a real dialect: no product project
      references them, because a module reaches YesSql through OrchardCore.Data.YesSql.
    -->
    <PackageVersion Include="YesSql.Abstractions" Version="5.4.7" />
    <PackageVersion Include="YesSql.Core" Version="5.4.7" />
    <PackageVersion Include="YesSql.Provider.Sqlite" Version="5.4.7" />
    <PackageVersion Include="YesSql.Provider.SqlServer" Version="5.4.7" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>
</Project>
