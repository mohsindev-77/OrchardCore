bin/
obj/
*.user
*.suo
.vs/
# A tenant's own data, and anything anyone names after it: App_Data_backup, App_Data.old,
# App_Data-2026-10-05. A copy taken to reproduce a defect is still a customer's organisation.
App_Data/
App_Data*/
# Belt and braces: a database file is never a source artefact, wherever it ends up.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
.env
TestResults/

# Orchard Core translation files copied in at build time, along with WorkMate's own
src/WorkMate.Web/Localization/

# Recipes copied in from /recipes at build time; /recipes is the source of truth
src/WorkMate.Web/Recipes/
