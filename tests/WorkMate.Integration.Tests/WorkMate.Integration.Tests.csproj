<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="OrchardCore.Roles.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="OrchardCore.Localization.Abstractions" />
    <!-- For the dimension engine's tenant tests: the audit trail category it registers, the
         content definitions it generates, and the title part settings it binds. -->
    <PackageReference Include="OrchardCore.AuditTrail.Abstractions" />
    <!-- For DeploymentPermissions.Import, pinned to Platform Administrator alone. -->
    <PackageReference Include="OrchardCore.Deployment.Core" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.Title" />
    <PackageReference Include="OrchardCore.Media" />
    <!-- For the one test that reaches past the graph service to corrupt the closure on purpose. -->
    <PackageReference Include="YesSql.Abstractions" />
    <!-- For creating a second, deliberately under-permissioned sign-in in tests that assert a
         screen is forbidden to a user lacking the permission it needs. -->
    <PackageReference Include="OrchardCore.Users.Core" />
    <PackageReference Include="OrchardCore.Users.Abstractions" />
    <!-- RenderedForm reads a GET response's actual <form> so a POST test submits exactly what the
         rendered page would, including fields the test author never thought to post — already
         pinned as a security override for a package Orchard pulls in transitively. -->
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WorkMate.Web/WorkMate.Web.csproj" />
  </ItemGroup>
</Project>
