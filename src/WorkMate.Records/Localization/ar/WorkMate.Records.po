#: Services/LookupListService.cs
msgid "'{0}' is not a valid entry code. Use letters, digits, hyphen, underscore, dot or slash, up to {1} characters, with no spaces."
msgstr "«{0}» ليس رمز مدخل صالحاً. استخدم حروفاً أو أرقاماً أو شرطة أو شرطة سفلية أو نقطة أو شرطة مائلة، بما لا يتجاوز {1} حرفاً، دون مسافات."

#: Services/LookupListService.cs
msgid "The entry code '{0}' is used more than once in this list."
msgstr "رمز المدخل «{0}» مستخدم أكثر من مرة في هذه القائمة."

#: Services/LookupListService.cs
msgid "The entry '{0}' needs an English name."
msgstr "يحتاج المدخل «{0}» إلى اسم بالإنجليزية."

#: Services/LookupListService.cs
msgid "The entry '{0}' cannot be removed from this list, because a record may already hold it and nothing would report that it no longer resolves. Retire it instead: it stops being offered and stays readable on the records that have it."
msgstr "لا يمكن إزالة المدخل «{0}» من هذه القائمة، لأن سجلاً قد يحمله بالفعل ولن يُبلّغ شيء بأنه لم يعد قابلاً للتحليل. أحِله إلى التقاعد بدلاً من ذلك: فيتوقف عرضه ويبقى مقروءاً على السجلات التي تحمله."

#: Services/LookupListService.cs
msgid "There is no lookup list with the id '{0}' in this tenant."
msgstr "لا توجد قائمة اختيار بالمعرّف «{0}» في هذا المستأجر."

#: Services/LookupListService.cs
msgid "'{0}' is defined by WorkMate and cannot be deleted. Its entries can still be retired."
msgstr "«{0}» مُعرَّفة من وركميت ولا يمكن حذفها. ويمكن مع ذلك إحالة مدخلاتها إلى التقاعد."

#: Services/LookupListService.cs
msgid "'{0}' still holds entries and cannot be deleted, because a record may already hold one of them. Retire the entries you no longer offer; a list can only be deleted while it is empty."
msgstr "«{0}» ما تزال تحمل مدخلات ولا يمكن حذفها، لأن سجلاً قد يحمل أحدها. أحِل المدخلات التي لم تعد تعرضها إلى التقاعد؛ فالقائمة لا تُحذف إلا وهي فارغة."

#. ---- the lookup list screens' messages ---------------------------------------------------

#: Controllers/LookupListsAdminController.cs
msgid "Lookup list '{0}' was created."
msgstr "أُنشئت قائمة الاختيار «{0}»."

#: Controllers/LookupListsAdminController.cs
msgid "Lookup list '{0}' was saved."
msgstr "حُفظت قائمة الاختيار «{0}»."

#: Controllers/LookupListsAdminController.cs
msgid "Lookup list '{0}' was deleted."
msgstr "حُذفت قائمة الاختيار «{0}»."

#: Controllers/LookupListsAdminController.cs
msgid "'{0}' cannot be deleted. A list can only be deleted while it holds no entries, because an entry may be a value records already carry — retire the entries you no longer offer instead."
msgstr "لا يمكن حذف «{0}». فالقائمة لا تُحذف إلا وهي خالية من المدخلات، لأن المدخل قد يكون قيمة تحملها السجلات بالفعل — أحِل المدخلات التي لم تعد تعرضها إلى التقاعد بدلاً من ذلك."

#. ---- the lookup-lists recipe step --------------------------------------------------------

#: Recipes/LookupListsRecipeStep.cs
msgid "Lookup list '{0}' is listed more than once."
msgstr "قائمة الاختيار «{0}» مذكورة أكثر من مرة."

#: Recipes/LookupListsRecipeStep.cs
msgid "'{0}' is not a valid lookup list code."
msgstr "«{0}» ليس رمز قائمة اختيار صالحاً."

#: Recipes/LookupListsRecipeStep.cs
msgid "Lookup list '{0}' states the entry code '{1}', which is not valid."
msgstr "تذكر قائمة الاختيار «{0}» رمز المدخل «{1}»، وهو غير صالح."

#: Recipes/LookupListsRecipeStep.cs
msgid "Lookup list '{0}' lists the entry '{1}' more than once."
msgstr "تذكر قائمة الاختيار «{0}» المدخل «{1}» أكثر من مرة."

#: Recipes/LookupListsRecipeStep.cs
msgid "Lookup list '{0}' already exists with different content: {1}."
msgstr "توجد قائمة الاختيار «{0}» بالفعل بمحتوى مختلف: {1}."

#: Recipes/LookupListsRecipeStep.cs
msgid "Lookup list '{0}' could not be created."
msgstr "تعذّر إنشاء قائمة الاختيار «{0}»."

#. ---- the audit trail's form configuration category ---------------------------------------

#: Services/FormsAuditTrail.cs
msgid "Lookup list changed"
msgstr "تغيّرت قائمة اختيار"

#: Services/FormsAuditTrail.cs
msgid "A list of choices was created, renamed, or had entries added or retired."
msgstr "أُنشئت قائمة خيارات أو أُعيدت تسميتها أو أُضيفت إليها مدخلات أو أُحيلت مدخلاتها إلى التقاعد."
