msgstr "إضافة وحدة"

#: Views/EmployeePlacementAdmin/Change.cshtml
msgid "Remove"
msgstr "إزالة"

#: Controllers/EmployeePlacementAdminController.cs
msgid "Choose a structure."
msgstr "اختر هيكلاً."

