# ---- the editor's hint after adding somebody ----

#: Views/EmployeesAdmin/Edit.cshtml
msgid "Added as prospective. Activate them when they start — it is a dated decision, so it can be recorded for the day they actually began."
msgstr "أُضيف بحالة «مرتقب». فعّله عند مباشرته العمل — وهو قرار مؤرَّخ، فيمكن تسجيله لليوم الذي باشر فيه فعلاً."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "Employee '{0}' is listed more than once."
msgstr "الموظف '{0}' مُدرَج أكثر من مرة."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "'{0}' is not a valid employee code."
msgstr "'{0}' ليس رمز موظف صالحاً."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "Employee '{0}' asks for status '{1}', which a new employee cannot be put into."
msgstr "الموظف '{0}' يطلب الحالة '{1}' ولا يمكن وضع موظف جديد فيها."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "Employee '{0}' already exists with different content: {1}."
msgstr "الموظف '{0}' موجود مسبقاً بمحتوى مختلف: {1}."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "Employee '{0}' names line manager '{1}', who does not exist."
msgstr "الموظف '{0}' يسمّي المدير المباشر '{1}' وهو غير موجود."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "'{0}' could not be created."
msgstr "تعذَّر إنشاء '{0}'."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "'{0}' could not be put into status '{1}'."
msgstr "تعذَّر وضع '{0}' في الحالة '{1}'."

#: WorkMate.Records.Recipes.EmployeesRecipeStep
msgid "'{0}' could not be given a line manager."
msgstr "تعذَّر إسناد مدير مباشر لـ '{0}'."

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Edit
msgid "What to export"
msgstr "ما الذي يتم تصديره"

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Edit
msgid "Employees, with their current employment status"
msgstr "الموظفون، مع حالتهم الوظيفية الحالية"

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Edit
msgid "Everybody on record, including people who have left. An employee's earlier statuses are in the audit trail rather than on the record, so the status exported is the one they are in now."
msgstr "كل من هو مسجَّل، بمن فيهم من تركوا العمل. حالات الموظف السابقة موجودة في سجل التدقيق لا في السجل نفسه، لذا فالحالة المصدَّرة هي حالته الآن."

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Summary
msgid "Employee records"
msgstr "سجلات الموظفين"

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Thumbnail
msgid "Exports the tenant's lookup lists and employees as the recipe steps the importers read. Apply lookup lists before anything naming a lookup value, and employees before the organisation's placements and head appointments, which name people by code."
msgstr "يصدّر قوائم الاختيار وموظفي المستأجر كخطوات الوصفة التي يقرأها المستورد. طبّق قوائم الاختيار قبل أي خطوة تسمّي قيمة منها، وطبّق الموظفين قبل مواضع العمل وتعيينات الرؤساء، فهي تسمّي الأشخاص بالرمز."

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Edit
msgid "Lookup lists, with their entries"
msgstr "قوائم الاختيار مع مدخلاتها"

#: WorkMate.Records.Views.RecordsDeploymentStep.Fields.Edit
msgid "The choices a form field offers, with each entry's code, both names, whether it is still offered and where it sits in the list. Apply this step before any step that names a lookup value."
msgstr "الخيارات التي يعرضها حقل النموذج، مع رمز كل مدخل واسميه وما إذا كان ما يزال معروضاً وموقعه في القائمة. طبّق هذه الخطوة قبل أي خطوة تسمّي قيمة من قوائم الاختيار."

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "Employees in {0} ({1}) as at {2}"
msgstr "الموظفون في {0} ({1}) بتاريخ {2}"

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "{0} at this unit."
msgstr "{0} في هذه الوحدة."

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "{0} at this unit and below it."
msgstr "{0} في هذه الوحدة وما تحتها."

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "A head who is not a member of the unit is listed but not counted."
msgstr "الرئيس الذي ليس عضواً في الوحدة يُدرج ولا يُحتسب."

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "Back to the chart"
msgstr "العودة إلى المخطط"

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "Include sub-units"
msgstr "تضمين الوحدات الفرعية"

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "Everybody below this unit on this structure as well, not only those placed at it."
msgstr "جميع من هم أسفل هذه الوحدة على هذا الهيكل أيضاً، لا المعيَّنون فيها فقط."

#. "Role here" became "Placement": a role is a job title, which this column never held. The values
#. became "Main" and "Additional" for the same reason — "Secondary" reads as a judgement about the
#. person rather than a statement about the unit's share of them.
#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "Placement"
msgstr "التعيين"

#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "Heads this unit"
msgstr "يرأس هذه الوحدة"

#. The star's tooltip, listing every unit this person heads. ADR-0012 lets one person head several.
#: Controllers/EmployeesAdminController.cs
msgid "Heads {0}"
msgstr "يرأس {0}"

#. The separator between names in a list. Arabic uses the Arabic comma, which is a different
#. character from the Latin one, so even this is a resource rather than a literal in the view.
#: Controllers/EmployeesAdminController.cs
msgid ", "
msgstr "، "

#. The "+N more" disclosure beside the main placement, for somebody split across several units.
#: WorkMate.Records.Views.EmployeesAdmin.Index
msgid "+{0} more"
msgstr "+{0} أخرى"

#: WorkMate.Records.Views.Shared._UnitRole
msgid "Additional"
msgstr "إضافي"

#: WorkMate.Records.Views.Shared._UnitRole
