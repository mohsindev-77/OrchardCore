<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- The module ships MVC views, which the Razor SDK only compiles when this is set. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.Data.YesSql" />
    <PackageReference Include="OrchardCore.Recipes.Abstractions" />
    <PackageReference Include="OrchardCore.Security" />
    <PackageReference Include="OrchardCore.Localization.Abstractions" />
    <!--
      BagPart and BagPartSettings, for the six standard sections. Verified against the pinned
      version with tools/api-probe: both live in OrchardCore.Flows.Core, and the OrchardCore.Flows
      feature has to be enabled on the tenant for the part definition to exist — which is why
      recipes/base.recipe.json now names it.
    -->
    <PackageReference Include="OrchardCore.Flows.Core" />
    <!-- TitlePartSettings, for the generated title on Employee and on every section item type. -->
    <PackageReference Include="OrchardCore.Title" />
    <!-- Where this module's three events are recorded. -->
    <PackageReference Include="OrchardCore.AuditTrail.Abstractions" />
    <!-- The admin screens: controllers, the admin menu, notifications and the shared component set. -->
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.ContentManagement.Display" />
    <!-- ContentPickerField and IContentPickerResultProvider, for the employee picker field. -->
    <PackageReference Include="OrchardCore.ContentFields" />


    <!-- The export deployment step: IDeploymentSource, DeploymentStep and the step driver. ADR-0011. -->

    <PackageReference Include="OrchardCore.Deployment.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkMate.Core/WorkMate.Core.csproj" />
    <ProjectReference Include="../WorkMate.Platform/WorkMate.Platform.csproj" />
    <ProjectReference Include="../WorkMate.Dimensions/WorkMate.Dimensions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- So that internal services and view models can be asserted directly rather than only
         through a rendered page. -->
    <InternalsVisibleTo Include="WorkMate.Records.Tests" />
    <InternalsVisibleTo Include="WorkMate.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tracked here, copied into the host's content root by Directory.Build.targets. -->
    <None Include="Localization/**/*.po" />
  </ItemGroup>
</Project>
