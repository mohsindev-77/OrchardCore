@model EmployeeSectionsViewModel

@* The sections of one employee record, on a WorkMate screen rather than on Orchard's generic
   content editor. The frame is ours; everything inside a section is still rendered by the display
   drivers that know how to edit a field — including this module's lookup editor on the bound ones.
   See EmployeeSectionsAdminController for what that division buys and why it is drawn there. *@

<h1>@T["Sections: {0}", Model.Name]</h1>

@* NOT A LIST OF SIX. The six WorkMate ships are what this screen renders today; the form designer
   publishes more in B3 and this sentence would then be a wrong statement printed above the right
   editor. Said about what a section IS instead, which stays true however many there are. *@
<p class="text-muted">
    @T["Each section is a list of rows kept over time, so earlier rows stay readable: add a new row when something changes rather than editing the one that was true before."]
</p>

<dl class="row mb-4">
    <dt class="col-sm-3">@T["Employee code"]</dt>
    <dd class="col-sm-9"><code id="employee-code">@Model.Code</code></dd>
</dl>

<form method="post" asp-action="Edit" asp-route-id="@Model.EmployeeId" id="employee-sections">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @(await DisplayAsync(Model.Editor))

    <div class="mt-3">
        @* No Save for a reader who may not change the record — an auditor holds ViewEmployees and
           not ManageEmployees. Not rendered rather than rendered and refused, like the lifecycle
           controls on the employee page. *@
        @if (Model.MaySave)
        {
            <button type="submit" class="btn btn-primary" id="employee-sections-save">@T["Save"]</button>
        }

        <a class="btn btn-link" asp-controller="EmployeesAdmin" asp-action="Edit" asp-route-id="@Model.EmployeeId">
            @T["Back to the employee"]
        </a>
    </div>
</form>
