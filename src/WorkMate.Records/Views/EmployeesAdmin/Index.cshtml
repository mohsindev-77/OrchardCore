@model EmployeeListViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>
        @if (Model.Unit is null)
        {
            @T["Employees"]
        }
        else
        {
            @* Which unit, on which structure, on which date — all three, because all three were
               chosen on the designer and any one of them being different makes this a different
               list. *@
            <span id="employee-unit-heading">@T["Employees in {0} ({1}) as at {2}",
                Model.Unit.UnitName, Model.Unit.StructureName, EmployeeDisplay.DateFromIso(Model.Unit.AsAtIso)]</span>
        }
    </h1>
    @if (Model.CanManage)
    {
        <a asp-action="Create" class="btn btn-primary">@T["Add employee"]</a>
    }
</div>

@if (Model.Unit is not null)
{
    <p class="text-muted" id="employee-unit-total">
        @if (Model.Unit.IncludeSubUnits)
        {
            @T["{0} at this unit and below it.", Model.Unit.MemberTotal]
        }
        else
        {
            @T["{0} at this unit.", Model.Unit.MemberTotal]
        }
        @* The head is on the list and not in the number, and the screen says so rather than leaving
           a reader to work out why the two differ by one. ADR-0012: a head need not work in the unit
           they head, and the unit they do work in is already counting them. *@
        @T["A head who is not a member of the unit is listed but not counted."]
        <a asp-controller="OrganisationDesignerAdmin" asp-action="Index"
           asp-route-structureId="@Model.Unit.StructureId"
           asp-route-asAt="@Model.Unit.AsAtIso"
           asp-route-expand="@Model.Unit.RecordId"
           id="employee-unit-back">@T["Back to the chart"]</a>
    </p>
}

@* A GET form, so a filtered list is a URL somebody can bookmark, share and come back to. *@
<form method="get" class="row g-2 align-items-end mb-3" id="employee-filter">
    @if (Model.Unit is not null)
    {
        @* The unit travels with the search rather than being dropped by it: a filter form that
           quietly widened to the whole tenant on first use would be worse than no search at all. *@
        <input type="hidden" name="structureId" value="@Model.Unit.StructureId" />
        <input type="hidden" name="recordId" value="@Model.Unit.RecordId" />
        <input type="hidden" name="asAt" value="@Model.Unit.AsAtIso" />
    }
    <div class="col-sm-5">
        <label class="form-label" for="employee-search">@T["Search"]</label>
        <input class="form-control" id="employee-search" type="search" name="search" value="@Model.Search"
               placeholder="@T["Code or name, in either language"]" />
    </div>
    <div class="col-sm-4">
        <label class="form-label" for="employee-status">@T["Status"]</label>
        <select class="form-select" id="employee-status" name="status">
            <option value="">@T["Every status, including leavers"]</option>
            @foreach (var status in Enum.GetValues<EmploymentStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)"><partial name="_EmploymentStatusName" model="status" /></option>
            }
        </select>
    </div>
    <div class="col-sm-3">
        <button type="submit" class="btn btn-secondary">@T["Filter"]</button>
    </div>
    @if (Model.Unit is not null)
    {
        @* Off by default. The card is the way in, the card's number counts the unit itself, and a
           screen that opened showing a different number from the one just clicked would be
           answering a question nobody asked. One click turns it on and the heading says so. *@
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="true"
                       id="employee-include-sub-units" name="includeSubUnits"
                       checked="@Model.Unit.IncludeSubUnits" />
                <label class="form-check-label" for="employee-include-sub-units">
                    @T["Include sub-units"]
                </label>
                <div class="form-text">@T["Everybody below this unit on this structure as well, not only those placed at it."]</div>
            </div>
        </div>
    }
</form>

@if (Model.Employees.Count == 0)
{
    <p id="employee-list-empty">
        @if (string.IsNullOrWhiteSpace(Model.Search) && Model.Status is null)
        {
            @T["No employees yet."]
        }
        else
        {
            @T["No employees match that filter."]
        }
    </p>
}
else
{
    <table class="table table-striped align-middle" id="employee-list">
        <thead>
            <tr>
                <th>@T["Code"]</th>
                <th>@T["Name"]</th>
                <th>@T["Status"]</th>
                <th>@T["Joined"]</th>
                <th>@T["Where they sit"]</th>
                @if (Model.Unit is not null)
                {
                    @* "Placement", not "Role here". A role is a job title, which this is not: it
                       is whether the unit is where this person mainly works or somewhere they are
                       also counted. *@
                    <th>@T["Placement"]</th>
                    <th class="text-end">@T["Allocation"]</th>
                }
                <th class="text-end">@T["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                @* The role is on the row as data as well as in a cell as words: a list of a unit's
                   members is one of the few places where "who is actually counted here" is a
                   question worth being able to ask of the markup, and a head who is not a member is
                   the row that answers it differently from how it reads. *@
                <tr class="employee-row" data-employee-code="@employee.Code"
                    data-unit-role="@employee.RoleHere">
                    <td><code>@employee.Code</code></td>
                    <td>
                        @if (employee.IsHeadHere)
                        {
                            @* A star rather than a column of its own: there is one head, so a
                               column would be blank on every row but one.

                               The tooltip names the units rather than saying "this one". One
                               person heading several is an ordinary shape — ADR-0012, and the
                               Zenith demo has somebody over two departments and a site team — and
                               a reader hovering a star wants to know how far that goes. *@
                            <span class="employee-head-marker" title="@employee.HeadsLabel">★</span>
                        }
                        <div dir="ltr" lang="en" class="employee-name d-inline">@employee.NameEn</div>
                        @* Only when there is Arabic to show: it is optional since ADR-0003's
                           addendum, so an untranslated row would otherwise carry a blank line. *@
                        @if (!string.IsNullOrWhiteSpace(employee.NameAr))
                        {
                            <div dir="rtl" lang="ar" class="text-muted small">@employee.NameAr</div>
                        }
                    </td>
                    <td>
                        <partial name="_EmploymentStatus" model="employee.Status" />
                        <div class="text-muted small">@T["since {0}", EmployeeDisplay.Date(employee.StatusEffectiveFrom)]</div>
                    </td>
                    <td>@EmployeeDisplay.Date(employee.JoinDate)</td>
                    <td class="employee-unit">
                        @* Placement is an assignment row in the dimension engine, never a field on
                           the record — architecture section 2. Empty is a real answer: somebody can
                           be employed and not yet placed anywhere. *@
                        @if (string.IsNullOrEmpty(employee.PrimaryUnitName))
                        {
                            <span class="text-muted">@T["Not placed"]</span>
                        }
                        else
                        {
                            @* The main placement, never an arbitrary one. Somebody split 60/40 has
                               two true answers to "where do they sit", and this column used to show
                               whichever row the engine returned first — so the same person could
                               read differently on two screens for no reason anybody could explain.

                               The full path is the cell's title rather than its text: it is what
                               tells Crescent's two "Credit" departments apart, and it is too long
                               to put on every row of a list somebody is scanning. *@
                            <span class="employee-unit-main" title="@employee.PrimaryUnitPath">@employee.PrimaryUnitName</span>

                            @if (employee.OtherUnits.Count > 0)
                            {
                                @* The rest behind a disclosure. Almost every row has none, so a
                                   column wide enough for the few would make the list harder to
                                   scan for the many — and <details> opens, closes and is
                                   keyboard-reachable with no script at all, which is the same
                                   choice the designer's action menu makes. *@
                                <details class="employee-unit-more d-inline-block ms-1">
                                    <summary class="employee-unit-more-toggle">@T["+{0} more", employee.OtherUnits.Count]</summary>
                                    <ul class="list-unstyled small text-muted mb-0">
                                        @foreach (var other in employee.OtherUnits)
                                        {
                                            <li class="employee-unit-other" data-record-id="@other.RecordId">
                                                @other.Path — @EmployeeDisplay.Percent(other.AllocationPercent)
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        }
                    </td>
                    @if (Model.Unit is not null)
                    {
                        <td class="employee-role-here">
                            <partial name="_UnitRole" model="employee" />
                        </td>
                        <td class="text-end employee-allocation">
                            @if (employee.AllocationPercent is { } allocation)
                            {
                                @EmployeeDisplay.Percent(allocation)
                            }
                            else
                            {
                                @* Not a zero: an appointment carries no allocation, and a zero would
                                   say the unit accounts for none of them, which is a different and
                                   false claim. *@
                                <span class="text-muted">—</span>
                            }
                        </td>
                    }
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end align-items-start">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary"
                                   asp-action="Edit" asp-route-id="@employee.EmployeeId">@T["Edit"]</a>
                                @if (Model.CanAssign)
                                {
                                    <a class="btn btn-outline-secondary employee-placement"
                                       asp-controller="EmployeePlacementAdmin" asp-action="Index"
                                       asp-route-id="@employee.EmployeeId">@T["Placement"]</a>
                                    @* Straight to the editable split, for the move somebody came
                                       to the list to make. The overview above it answers "where is
                                       this person"; this answers "put them somewhere else", and
                                       making the second reachable only through the first is what
                                       left splitting an allocation two clicks and a guess away. *@
                                    <a class="btn btn-outline-secondary employee-change-placement"
                                       asp-controller="EmployeePlacementAdmin" asp-action="Change"
                                       asp-route-id="@employee.EmployeeId"
                                       asp-route-structureId="@Model.Unit?.StructureId">@T["Change placement"]</a>
                                }
                            </div>
                            @* Every transition valid for this person's current status, and only
                               those. Session A2 offered Exit alone, which left Activate — the move
                               every newly added employee needs — reachable only by typing a URL. *@
                            <partial name="_LifecycleActions"
                                     model="@(new LifecycleActionsViewModel(
                                         employee.EmployeeId,
                                         employee.Transitions,
                                         Model.CanChangeStatus,
                                         AsMenu: true))" />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">@T["Showing {0} of {1}.", Model.Employees.Count, Model.Total]</p>

    @if (Model.HasMore)
    {
        <a class="btn btn-outline-secondary"
           asp-action="Index"
           asp-route-search="@Model.Search"
           asp-route-status="@Model.Status"
           asp-route-skip="@(Model.Skip + Model.Take)"
           asp-route-take="@Model.Take">@T["Next page"]</a>
    }
}
