<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- The module ships MVC views, which the Razor SDK only compiles when this is set. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.ContentManagement.Display" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Data.YesSql" />
    <PackageReference Include="OrchardCore.Recipes.Abstractions" />
    <!-- The export deployment step: IDeploymentSource, DeploymentStep and the step driver. ADR-0011. -->
    <PackageReference Include="OrchardCore.Deployment.Abstractions" />
    <PackageReference Include="OrchardCore.Security" />
    <PackageReference Include="OrchardCore.Localization.Abstractions" />
    <!--
      Infrastructure.Abstractions gives IIdGenerator, which mints the stable ids dimension types
      and structures are referenced by. AuditTrail.Abstractions is how specification section 4's
      "recorded in the audit trail with a diff" is satisfied. Title is referenced for
      TitlePartSettings alone: section 4 requires TitlePart bound to NameEn on every generated
      type, and the settings type is the only way to express that binding.
    -->
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="OrchardCore.AuditTrail.Abstractions" />
    <!-- The CLR field types a dimension type's custom attributes are written to: TextField,
         NumericField, BooleanField, DateField. The definitions were always written by name; adding
         a unit through the designer is the first path that has to set their values. -->
    <PackageReference Include="OrchardCore.ContentFields" />
    <PackageReference Include="OrchardCore.Title" />
    <!--
      Admin.Abstractions: the [Admin] route attribute the three admin controllers carry.
      Navigation.Core: INavigationProvider/NavigationBuilder for the "Organisation" admin menu.
      Both were previously reachable only transitively through the WorkMate.Platform project
      reference; declared directly here because this module now uses them itself.
    -->
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkMate.Core/WorkMate.Core.csproj" />
    <ProjectReference Include="../WorkMate.Platform/WorkMate.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      So that internal rules can be asserted directly instead of only through a public API.
      The integration suite needs it for one thing in particular: proving that closure
      verification actually detects a corrupt index. There is deliberately no public way to
      corrupt the index, so the only way to show the safety net works is to reach past it.
    -->
    <InternalsVisibleTo Include="WorkMate.Dimensions.Tests" />
    <InternalsVisibleTo Include="WorkMate.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tracked here, copied into the host's content root by Directory.Build.targets. -->
    <None Include="Localization/**/*.po" />
  </ItemGroup>
</Project>
