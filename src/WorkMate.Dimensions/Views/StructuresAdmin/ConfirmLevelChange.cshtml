@model StructureLevelChangeConfirmationViewModel

<h1>@T["Confirm structure change"]</h1>

<p>
    @T["'{0}' already has records placed on it. Review what this change does before it is applied.", Model.Code]
</p>

@if (Model.AddedLevelLabels.Count > 0)
{
    <div class="alert alert-info">
        <p class="mb-1">@T["Adding these types is safe: units of them already exist and will be visible in this structure from today."]</p>
        <ul class="mb-0">
            @foreach (var label in Model.AddedLevelLabels)
            {
                <li>@label</li>
            }
        </ul>
    </div>
}

@if (Model.RemovalImpacts.Count > 0)
{
    <div class="alert alert-warning">
        <p class="mb-1">@T["Dropping a type does not delete anything — the affected units stop being offered in this structure from today, and every historical report still resolves as before — but review the counts first."]</p>
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>@T["Type being dropped"]</th>
                    <th>@T["Records affected"]</th>
                    <th>@T["Employees affected today"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var impact in Model.RemovalImpacts)
                {
                    <tr>
                        <td>@impact.Label</td>
                        <td>@impact.RecordCount</td>
                        <td>@impact.EmployeesAffected</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<form asp-action="EditConfirmed" method="post">
    <input type="hidden" asp-for="StructureId" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="NameEn" />
    <input type="hidden" asp-for="NameAr" />
    <input type="hidden" asp-for="AllowSkipLevel" />
    <input type="hidden" asp-for="IsStrict" />
    <input type="hidden" asp-for="IsPrimaryOrganisation" />
    @foreach (var index in Enumerable.Range(0, Model.LevelDimensionTypeIds.Count))
    {
        <input type="hidden" name="LevelDimensionTypeIds[@index]" value="@Model.LevelDimensionTypeIds[index]" />
    }
    @* The grid, carried through exactly as posted. It is not derivable from the level order — that
       is the whole point of it — so rebuilding it here would apply a different change from the one
       measured above. *@
    @foreach (var rootTypeId in Model.RootDimensionTypeIds)
    {
        <input type="hidden" name="RootDimensionTypeIds" value="@rootTypeId" />
    }
    @foreach (var pair in Model.ContainmentPairs)
    {
        <input type="hidden" name="ContainmentPairs" value="@pair" />
    }

    <button type="submit" class="btn btn-primary">@T["Yes, apply this change"]</button>
    <a asp-action="Edit" asp-route-id="@Model.StructureId" class="btn btn-link">@T["Back, nothing changed yet"]</a>
</form>
