@model DimensionTypeRetireViewModel

<h1>@T["Retire dimension type"]</h1>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<p>
    @T["'{0}' will stop being offered for new records from the date below. Existing records of this type, and every historical report that refers to it, keep resolving as before.", Model.NameEn]
</p>

<form asp-action="Retire" method="post">
    <input type="hidden" asp-for="DimensionTypeId" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="NameEn" />

    <div class="mb-3">
        <label asp-for="EffectiveDate" class="form-label">@T["Effective date"]</label>
        <input asp-for="EffectiveDate" type="date" class="form-control w-auto" required="required" />
        <span asp-validation-for="EffectiveDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">@T["Retire"]</button>
    <a asp-action="Index" class="btn btn-link">@T["Cancel"]</a>
</form>
