@model UnitHeadViewModel

<h1>@T["Who heads {0}?", Model.UnitName]</h1>

<p class="text-muted">
    @T["On {0}, in {1}.", BilingualDisplay.DateFromIso(Model.AsAt), Model.StructureName]
</p>

@if (Model.IsVacant)
{
    <p id="unit-head-current" class="text-muted">@T["This unit has no head on that date."]</p>
}
else
{
    <p id="unit-head-current">
        @T["{0} has headed it since {1}. Appointing somebody else ends that term the day before the new one starts.",
            Model.CurrentHeadName!, BilingualDisplay.Date(Model.CurrentHeadFrom)]
    </p>
}

<div class="alert alert-info">
    @* The claim that made this its own record rather than a flag on an assignment. ADR-0012. *@
    @T["A head does not have to work in the unit they head. An acting head borrowed from another department is ordinary, and an appointment carries no allocation — nobody is counted by this unit's headcount or charged to its cost centre because of it."]
</div>

<form method="post" asp-action="Set" id="unit-head-set">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="StructureId" />
    <input type="hidden" asp-for="RecordId" />
    <input type="hidden" asp-for="AsAt" />
    <input type="hidden" asp-for="UnitNameEn" />

    @* No "nobody" option: clearing a head is its own dated operation, because a post with nothing
       selected cannot say which day the unit became vacant. *@
    <workmate-employee-picker for="EmployeeId" label="@T["Head of this unit"]" allow-none="false" />

    <div class="mb-3">
        <label class="form-label" asp-for="EffectiveFrom">@T["From"]</label>
        <input class="form-control" asp-for="EffectiveFrom" type="date" required />
        <div class="form-text">
            @T["The first day of the new term. Prompt 5's approval routing resolves the head for the date it is asked about, so this is the date from which approvals start reaching them."]
        </div>
    </div>

    <button type="submit" class="btn btn-primary">@T["Appoint"]</button>
    @if (!Model.IsVacant)
    {
        <a class="btn btn-outline-danger"
           asp-action="Clear"
           asp-route-structureId="@Model.StructureId"
           asp-route-recordId="@Model.RecordId"
           asp-route-asAt="@Model.AsAt">@T["Leave the post vacant instead"]</a>
    }
    <a class="btn btn-link"
       asp-controller="OrganisationDesignerAdmin" asp-action="Index"
       asp-route-structureId="@Model.StructureId" asp-route-asAt="@Model.AsAt">@T["Cancel"]</a>
</form>

@if (Model.Terms.Count > 0)
{
    <h2 class="mt-4">@T["Who has headed this unit"]</h2>
    <table class="table table-sm" id="unit-head-terms">
        <thead>
            <tr>
                <th>@T["Head"]</th>
                <th>@T["From"]</th>
                <th>@T["To"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var term in Model.Terms)
            {
                <tr class="unit-head-term">
                    <td>@term.EmployeeName</td>
                    <td>@BilingualDisplay.Date(term.From)</td>
                    <td>@(term.IsOpenEnded ? T["present"] : (object)BilingualDisplay.Date(term.To))</td>
                </tr>
            }
        </tbody>
    </table>
}
