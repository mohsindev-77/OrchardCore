@model DesignerNodeViewModel
@*
    One unit, in whichever view is showing: the chart draws this as a card, the list as a row, from
    the same markup. Index.cshtml renders it for the structure card, for each root, and once with
    an empty model inside the <template> the script clones for lazily loaded children — so there is
    one definition of a card's markup rather than a Razor copy and a JavaScript copy that drift
    apart.

    The expand control is the same control on every card: present with a count when there is
    something under it, absent when there is not. It is never a control that looks different on one
    card than another because of what has already been clicked.
*@
<li class="designer-node @(Model.IsStructure ? "designer-node-structure" : null)"
    data-record-id="@Model.RecordId"
    data-expanded="@(Model.IsStructure ? "true" : "false")"
    data-child-count="@Model.ChildCount"
    data-loaded="@(Model.IsStructure ? "true" : null)">
    <div class="designer-card">
        @* Both states are always rendered and one of them hidden, rather than only the one that
           applies: the <template> this partial also renders is cloned for every lazily loaded
           child, and a template missing the button could never grow one. The script flips the
           same two attributes the server sets here. *@
        <button type="button" class="designer-toggle"
                aria-label="@T["Expand or collapse this unit"]"
                aria-expanded="@(Model.IsStructure ? "true" : "false")"
                hidden="@(Model.ChildCount > 0 ? null : "hidden")">
            <span class="designer-toggle-icon" aria-hidden="true">▸</span>
            <span class="designer-toggle-count">@Model.ChildCount</span>
        </button>
        @* Keeps a childless card's text aligned with every other card's, without pretending there
           is something to expand. *@
        <span class="designer-toggle-spacer" aria-hidden="true" hidden="@(Model.ChildCount > 0 ? "hidden" : null)"></span>
        @if (Model.CanEdit)
        {
            @* <details>, not a scripted dropdown: it opens, closes and is keyboard-reachable with
               no JavaScript at all, and the actions inside it are ordinary links to ordinary
               pages. A reader without ManageDimensionRecords gets the same card with no menu on
               it — the server does not render one, rather than hiding one with CSS. *@
            <details class="designer-actions">
                <summary class="designer-actions-toggle" title="@T["Actions"]">
                    <span aria-hidden="true">⋯</span>
                    <span class="visually-hidden">@T["Actions for this unit"]</span>
                </summary>
                <div class="designer-actions-menu">
                    <a class="designer-action" data-designer-action="add"
                       asp-action="AddUnit"
                       asp-route-structureId="@Model.StructureId"
                       asp-route-parentId="@(Model.IsStructure ? null : Model.RecordId)"
                       asp-route-asAt="@Model.AsAtIso">@T["Add unit"]</a>
                    @if (!Model.IsStructure)
                    {
                        <a class="designer-action" data-designer-action="rename"
                           asp-action="Rename"
                           asp-route-structureId="@Model.StructureId"
                           asp-route-recordId="@Model.RecordId"
                           asp-route-asAt="@Model.AsAtIso">@T["Rename"]</a>
                        <a class="designer-action" data-designer-action="retire"
                           asp-action="Retire"
                           asp-route-structureId="@Model.StructureId"
                           asp-route-recordId="@Model.RecordId"
                           asp-route-asAt="@Model.AsAtIso">@T["Retire"]</a>
                    }
                </div>
            </details>
        }
        <div class="designer-card-body">
            @* title, because the chart gives every card the same fixed size and cuts anything that
               does not fit; the full name stays one hover away rather than being lost. *@
            <div class="designer-card-name" dir="ltr" lang="en" title="@Model.NameEn">@Model.NameEn</div>
            <div class="designer-card-name-ar" dir="rtl" lang="ar" title="@Model.NameAr">@Model.NameAr</div>
            @if (Model.IsStructure)
            {
                <div class="designer-card-meta">
                    <span class="designer-card-type">@T["Structure"]</span>
                    <code class="designer-card-code">@Model.Code</code>
                </div>
            }
            else
            {
                <div class="designer-card-meta">
                    <span class="designer-card-type">@Model.DimensionTypeNameEn</span>
                    <code class="designer-card-code">@Model.Code</code>
                </div>
                @* A dash, not "Vacant": nothing can be a unit's head until employees exist, so the
                   card cannot yet tell an unfilled post from an unbuilt feature. See the backlog
                   note in the module README and in prompt 4 of the prompt library. *@
                <div class="designer-card-head">@(Model.HeadDisplayName is null ? T["Head: —"] : T["Head: {0}", Model.HeadDisplayName])</div>
                @* One expression rather than an @if block, so a unit with nobody at it renders an
                   element with no whitespace in it at all — which is what :empty needs to hide it. *@
                <div class="designer-card-employees">@(Model.EmployeeCount is { } employees ? T["{0} employees", employees].Value : string.Empty)</div>
            }
        </div>
    </div>
    <ul class="designer-children" hidden="@(Model.Children.Count > 0 ? null : "hidden")">
        @foreach (var child in Model.Children)
        {
            await Html.RenderPartialAsync("_DesignerNode", child);
        }
    </ul>
</li>
