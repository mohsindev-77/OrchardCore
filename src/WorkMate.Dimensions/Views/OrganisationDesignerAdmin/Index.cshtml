@model OrganisationDesignerViewModel
@{
    var isChart = Model.ViewMode == DesignerViewMode.Chart;
    // ToIso, not ToString with the ambient culture: under a culture whose default calendar is not
    // Gregorian this is a different year, and it is the value the date input and every fetch the
    // page makes are built from. See WorkMate.Dimensions.Internal.IsoDate.
    var asAtValue = Model.AsAt.ToIso();

    // The action map the script points a fetched card's links at: one entry per action this viewer
    // may use, from the one list DesignerCardActions declares. Serialised here rather than in the
    // view model because only a view has a URL helper, and the routes must be generated rather
    // than written out — a hand-built path is a path that survives a route change and stops
    // working.
    var designerActionUrls = System.Text.Json.JsonSerializer.Serialize(
        Model.PermittedActions.ToDictionary(
            action => action.Name,
            action => new
            {
                url = action.Controller is null
                    ? Url.Action(action.Action)
                    : Url.Action(action.Action, action.Controller),
                targetsParent = action.TargetsParent,
            }));
}

@* Named, not pathed. Orchard puts a content hash on the URL, so changing the file changes the URL
   and a browser cannot keep serving a cached copy for the thirty days the static file middleware
   asks it to. See WorkMateDimensionsResourceManifest. *@
<style asp-name="workmate-organisation-designer"></style>

<h1>@T["Organisation designer"]</h1>

@if (Model.Structures.Count == 0)
{
    <p>@T["No structures have been created yet."]</p>
    return;
}

@* One GET form carries every choice that changes what is shown, so the screen is addressable by
   URL and works with no script at all: picking a structure, a date or a view reloads with the
   choice in the query string, and the controller remembers the view in a cookie. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-5 col-lg-4">
        <label class="form-label" for="structureId">@T["Structure"]</label>
        <select id="structureId" name="structureId" class="form-select" data-designer-autosubmit>
            @foreach (var structure in Model.Structures)
            {
                <option value="@structure.StructureId" selected="@(structure.StructureId == Model.SelectedStructureId)">
                    @structure.NameEn (@structure.Code)
                </option>
            }
        </select>
    </div>

    @if (Model.CanViewHistory)
    {
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="asAt">@T["Show the organisation as at"]</label>
            <input type="date" id="asAt" name="asAt" class="form-control" value="@asAtValue" data-designer-autosubmit />
        </div>
    }

    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">@T["Show"]</button>
    </div>

    <div class="col-auto ms-sm-auto">
        <div class="btn-group" role="group" aria-label="@T["View"]">
            <a class="btn btn-sm @(isChart ? "btn-primary" : "btn-outline-secondary")"
               data-designer-view="Chart"
               asp-action="Index"
               asp-route-structureId="@Model.SelectedStructureId"
               asp-route-asAt="@asAtValue"
               asp-route-view="Chart">@T["Chart"]</a>
            <a class="btn btn-sm @(isChart ? "btn-outline-secondary" : "btn-primary")"
               data-designer-view="List"
               asp-action="Index"
               asp-route-structureId="@Model.SelectedStructureId"
               asp-route-asAt="@asAtValue"
               asp-route-view="List">@T["List"]</a>
        </div>
    </div>
</form>

@if (Model.SelectedStructureId is null)
{
    <p>@T["Choose a structure to see its tree."]</p>
    return;
}

@if (!Model.IsAsAtToday)
{
    <div class="alert alert-info py-2">
        @T["Showing this structure as it was on {0}. Nothing on this screen changes anything.", BilingualDisplay.Date(Model.AsAt)]
        <a asp-action="Index" asp-route-structureId="@Model.SelectedStructureId" asp-route-view="@Model.ViewMode">@T["Back to today"]</a>
    </div>
}

<div class="row g-3 designer-surface"
     data-structure-id="@Model.SelectedStructureId"
     data-as-at="@asAtValue"
     data-children-url="@Url.Action("Children")"
     data-search-url="@Url.Action("Search")"
     data-view-cookie="@OrganisationDesignerViewModel.ViewModeCookieName"
     data-expand-path="@string.Join(",", Model.ExpandPath)"
     @*
        One attribute for every action this viewer may use, built from DesignerCardActions.All —
        the same list the card partial's menu and the script both read. It replaced one
        data-<action>-url attribute per action, which had to be kept in step by hand with the
        markup and with an object literal in the script; forgetting any one of the three produced
        a menu that was complete on the roots and silently short an item on every fetched card.
        See OrganisationDesignerViewModel.PermittedActions.

        Each entry also says whether the unit's id travels as parentId or recordId, so the script
        does not need to know that "add" is the odd one out.
     *@
     data-action-urls="@designerActionUrls"
     data-can-move="@(Model.CanMove ? "true" : "false")">

    <div class="col-lg-8 col-xl-9">
        <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
            <div class="flex-grow-1" style="max-width: 24rem;">
                <label class="form-label" for="designer-search">@T["Search this structure"]</label>
                <input type="search" id="designer-search" class="form-control form-control-sm" autocomplete="off"
                       placeholder="@T["Search by code or name"]" />
            </div>

            @* Rendered visible by the server in chart view rather than unhidden by script, so a
               broken script cannot silently remove them; the script only hides them when the list
               is showing, where there is nothing to zoom. *@
            <div class="btn-group btn-group-sm" role="group" aria-label="@T["Zoom"]" id="designer-zoom-controls" hidden="@(isChart ? null : "hidden")">
                <button type="button" class="btn btn-outline-secondary" data-designer-zoom="out" aria-label="@T["Zoom out"]">−</button>
                <button type="button" class="btn btn-outline-secondary" data-designer-zoom="fit">@T["Fit to screen"]</button>
                <button type="button" class="btn btn-outline-secondary" data-designer-zoom="in" aria-label="@T["Zoom in"]">+</button>
            </div>
        </div>

        <ul id="designer-search-results" class="list-group mb-2" hidden></ul>

        @if (Model.Roots.Count == 0)
        {
            <p class="text-muted">@T["This structure has no top-level units on this date."]</p>
        }
        else
        {
            <div class="designer-chart-viewport @(isChart ? "designer-chart" : "designer-list")">
                <div class="designer-chart-canvas">
                    <div id="designer-tree">
                        @* One top card — the structure — with the roots already beneath it. Every
                           deeper level is fetched when its branch is first expanded. *@
                        <ul>
                            @{ await Html.RenderPartialAsync("_DesignerNode", Model.StructureCard); }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4 col-xl-3">
        <h2 class="fs-5">@T["Unplaced records"]</h2>
        <p class="text-muted small">
            @T["Units with no parent in this structure on this date. They cannot be reached by expanding the tree."]
        </p>
        @if (Model.Unplaced.Count == 0)
        {
            <p class="text-muted">@T["Nothing unplaced in this structure."]</p>
        }
        else
        {
            @* The same partial the tree uses, so an unplaced unit is a card like any other: same
               action menu, same drag behaviour, same markup for a test to find. It was a bespoke
               list before, which is exactly why it quietly had no menu and could not be dragged —
               and why nothing in the browser suite noticed, since every test looks for
               .designer-node and these were not one. *@
            <ul class="designer-unplaced" id="designer-unplaced">
                @foreach (var node in Model.Unplaced)
                {
                    await Html.RenderPartialAsync("_DesignerNode", node);
                }
            </ul>
        }
    </div>
</div>

@* The script clones this for every lazily loaded child. Rendered from the same partial as the
   roots above, with an empty model, so there is no second copy of a unit's markup to keep in step. *@
<template id="designer-node-template">
    @{ await Html.RenderPartialAsync("_DesignerNode", Model.NodeTemplate); }
</template>

<script asp-name="workmate-organisation-designer" at="Foot"></script>
