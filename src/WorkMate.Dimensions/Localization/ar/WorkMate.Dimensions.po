msgstr "'{0}' و'{1}' من النوع نفسه، والهيكل '{2}' لا يسمح بتداخل هذا النوع داخل نفسه."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "The structure '{0}' does not allow a unit like '{1}' under one like '{2}'."
msgstr "الهيكل '{0}' لا يسمح بوحدة مثل '{1}' تحت وحدة مثل '{2}'."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "'{0}' is named in this structure's rules but is not one of its types."
msgstr "'{0}' مذكور في قواعد هذا الهيكل لكنه ليس من أنواعه."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "A structure needs at least one kind of unit that may sit at its top."
msgstr "يحتاج الهيكل إلى نوع واحد على الأقل من الوحدات يمكن أن يكون في قمته."

#: WorkMate.Dimensions.Internal.Graph.DimensionGraphService
msgid "'{0}' is currently placed under '{1}'. The new rules for '{2}' would not allow that."
msgstr "'{0}' موضوع حاليًا تحت '{1}'. القواعد الجديدة لـ'{2}' لن تسمح بذلك."

#: WorkMate.Dimensions.Recipes.StructuresRecipeStep
msgid "Structure '{0}' names type '{1}' in its rules, which does not exist."
msgstr "الهيكل '{0}' يذكر النوع '{1}' في قواعده، وهو غير موجود."

#: WorkMate.Dimensions.Recipes.StructuresRecipeStep
