msgstr "تواريخ السريان"

#: Views/DimensionRecordPart.Edit.cshtml
msgid "From"
msgstr "من"

#: Views/DimensionRecordPart.Edit.cshtml
msgid "To"
msgstr "إلى"

#: Views/DimensionRecordPart.Edit.cshtml
msgid "Leave empty while the record is open ended. The last day is included."
msgstr "اتركه فارغًا ما دام السجل مفتوح المدة. اليوم الأخير مشمول."

#: Views/DimensionRecordPart.Edit.cshtml
msgid "Offered in pickers"
msgstr "متاح في قوائم الاختيار"

#: Views/DimensionRecordPart.Edit.cshtml
msgid "Sort order"
msgstr "ترتيب العرض"

#: Views/DimensionRecordPart.Edit.cshtml
#: Views/DimensionRecordPart.cshtml
msgid "Cost centre code"
msgstr "رمز مركز التكلفة"

#: Views/DimensionRecordPart.Edit.cshtml
#: Views/DimensionRecordPart.cshtml
msgid "GL account"
msgstr "حساب الأستاذ العام"

#: Views/DimensionRecordPart.Edit.cshtml
msgid "Head of unit"
msgstr "رئيس الوحدة"

#: Views/DimensionRecordPart.Edit.cshtml
msgid "The head need not be a member of this unit."
msgstr "ليس من الضروري أن يكون الرئيس عضوًا في هذه الوحدة."

#: Views/DimensionRecordPart.cshtml
msgid "Name"
msgstr "الاسم"

#: Views/DimensionRecordPart.cshtml
msgid "Effective"
msgstr "السريان"

#: Views/DimensionRecordPart.cshtml
msgid "From {0}"
msgstr "من {0}"

#: Views/DimensionRecordPart.cshtml
msgid "{0} to {1}"
msgstr "من {0} إلى {1}"

#: Views/DimensionRecordPart.cshtml
msgid "Status"
msgstr "الحالة"

#: Views/DimensionRecordPart.cshtml
msgid "Not offered in pickers"
msgstr "غير متاح في قوائم الاختيار"

# ---- Graph layer: moves, merges and assignments ----

#: WorkMate.Dimensions.Internal.Graph.DimensionGraphService
msgid "A record cannot be its own parent."
msgstr "لا يمكن أن يكون السجل أبًا لنفسه."

#: WorkMate.Dimensions.Internal.Graph.DimensionGraphService
msgid "'{0}' is at or below '{1}' at some point in time, so moving '{1}' under it would create a cycle."
msgstr "'{0}' يقع عند '{1}' أو تحته في وقت ما، لذا فإن نقل '{1}' تحته سينشئ حلقة مغلقة."

#: WorkMate.Dimensions.Internal.Graph.DimensionService
msgid "There is no dimension record with the id '{0}' in this tenant."
msgstr "لا يوجد سجل بعد بالمعرّف '{0}' في هذا المستأجر."

#: WorkMate.Dimensions.Internal.Graph.DimensionService
msgid "There is no name in effect on {0} to correct."
msgstr "لا يوجد اسم ساري في {0} ليتم تصحيحه."

#: WorkMate.Dimensions.Internal.Graph.DimensionService
msgid "The record had no name on {0}, so it cannot be renamed from then."
msgstr "لم يكن للسجل اسم في {0}، لذا لا يمكن إعادة تسميته اعتبارًا من ذلك التاريخ."

#: WorkMate.Dimensions.Internal.Graph.DimensionService
msgid "A record cannot be merged into itself."
msgstr "لا يمكن دمج السجل في نفسه."

#: WorkMate.Dimensions.Internal.Graph.DimensionService
msgid "'{0}' is inside '{1}', so it cannot be the target of merging '{1}' into it."
msgstr "'{0}' يقع داخل '{1}'، لذا لا يمكن أن يكون هدفًا لدمج '{1}' فيه."

#: WorkMate.Dimensions.Internal.Graph.EmployeeAssignmentService
msgid "A placement needs at least one unit. Use the end operation to remove an employee from a structure."
msgstr "يحتاج التعيين إلى وحدة واحدة على الأقل. استخدم عملية الإنهاء لإزالة موظف من هيكل."

#: WorkMate.Dimensions.Internal.Graph.EmployeeAssignmentService
msgid "Allocations must total 100 percent on any one date. These total {0}."
msgstr "يجب أن يكون مجموع النسب 100 بالمئة في أي تاريخ. مجموع هذه النسب {0}."

#: WorkMate.Dimensions.Internal.Graph.EmployeeAssignmentService
msgid "An allocation must be greater than zero. Remove the placement instead."
msgstr "يجب أن تكون النسبة أكبر من صفر. احذف التعيين بدلًا من ذلك."

#: WorkMate.Dimensions.Internal.Graph.EmployeeAssignmentService
msgid "Exactly one placement must be primary, so that matrix cases stay unambiguous. {0} are marked primary."
msgstr "يجب أن يكون تعيين واحد فقط أساسيًا، حتى تبقى الحالات المصفوفية واضحة. عدد التعيينات الأساسية {0}."

#: WorkMate.Dimensions.Internal.Graph.EmployeeAssignmentService
msgid "An employee cannot be placed at the same node twice on the same date."
msgstr "لا يمكن تعيين الموظف في الوحدة نفسها مرتين في التاريخ نفسه."

# ---- The validator: the rules of architecture section 6 in one place ----

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "The code '{0}' is already used by another dimension record in this tenant."
msgstr "الرمز '{0}' مستخدم بالفعل في سجل بعد آخر في هذا المستأجر."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "'{0}' is not effective on {1}. The placement is allowed, but check the dates."
msgstr "'{0}' غير ساري في {1}. التعيين مسموح به، لكن تحقق من التواريخ."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "'{0}' was retired on {1} and cannot take on a new placement from {2}."
msgstr "تم إيقاف '{0}' في {1} ولا يمكنه قبول تعيين جديد اعتبارًا من {2}."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "{0} employee placement(s) are live at this record today."
msgstr "يوجد {0} تعيين موظف نشط في هذا السجل اليوم."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "{0} past employee placement(s) refer to this record."
msgstr "يشير {0} تعيين موظف سابق إلى هذا السجل."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "{0} record(s) sit under this one. Move or merge them first."
msgstr "يوجد {0} سجل تحت هذا السجل. انقلها أو ادمجها أولًا."

#: WorkMate.Dimensions.Internal.Graph.DimensionGraphService
msgid "There is no move recorded for '{0}' effective on {1}."
msgstr "لا يوجد نقل مسجَّل لـ '{0}' ساري من {1}."

