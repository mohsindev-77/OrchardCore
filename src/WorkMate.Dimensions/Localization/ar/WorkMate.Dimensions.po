# Stage B: the organisation designer's mutations — add a unit, rename, retire.

msgid "Actions"
msgstr "إجراءات"

msgid "Actions for this unit"
msgstr "إجراءات هذه الوحدة"

msgid "Add unit"
msgstr "إضافة وحدة"

msgid "Add a unit"
msgstr "إضافة وحدة"

msgid "Rename"
msgstr "إعادة تسمية"

msgid "Retire"
msgstr "إيقاف"

msgid "A new top-level unit of {0}."
msgstr "وحدة جديدة في المستوى الأعلى من {0}."

msgid "A new unit under {0}, in {1}."
msgstr "وحدة جديدة تحت {0}، في {1}."

msgid "Nothing can be added here: this unit is already at the deepest level this structure defines."
msgstr "لا يمكن إضافة شيء هنا: هذه الوحدة في أعمق مستوى يحدده هذا الهيكل."

msgid "Back to the designer"
msgstr "العودة إلى المصمم"

msgid "Kind of unit"
msgstr "نوع الوحدة"

msgid "This structure allows more than one kind of unit here."
msgstr "يسمح هذا الهيكل بأكثر من نوع واحد من الوحدات هنا."

msgid "Change kind"
msgstr "تغيير النوع"

msgid "Code"
msgstr "الرمز"

msgid "Letters, digits, hyphens and underscores. Unique in this tenant, and permanent."
msgstr "حروف وأرقام وشرطات وشرطات سفلية. فريد في هذا المستأجر، ودائم."

msgid "Name"
msgstr "الاسم"

msgid "Effective from"
msgstr "ساري من"

msgid "The day this unit starts existing. It will not appear on the tree before then."
msgstr "اليوم الذي تبدأ فيه هذه الوحدة بالوجود. لن تظهر في الشجرة قبل ذلك."

msgid "Details"
msgstr "التفاصيل"

msgid "Defined on this kind of unit in the Dimension types screen."
msgstr "محددة على هذا النوع من الوحدات في شاشة أنواع الأبعاد."

msgid "Enter the date this unit starts."
msgstr "أدخل تاريخ بدء هذه الوحدة."

msgid "Rename a unit"
msgstr "إعادة تسمية وحدة"

msgid "Currently {0}"
msgstr "حاليًا {0}"

msgid "New name"
msgstr "الاسم الجديد"

msgid "What kind of change is this?"
msgstr "ما نوع هذا التغيير؟"

msgid "The unit has been renamed"
msgstr "أُعيدت تسمية الوحدة"

msgid "It genuinely becomes this from the date below. Reports for earlier periods keep showing the old name, because that is what it was called then."
msgstr "تصبح كذلك فعليًا من التاريخ أدناه. تستمر تقارير الفترات السابقة في إظهار الاسم القديم، لأنه ما كانت تُسمى به حينها."

msgid "The old name was a mistake"
msgstr "كان الاسم القديم خطأً"

msgid "Correct it wherever it appears, including in earlier periods. Use this for a typo, not for a real change of name."
msgstr "صحّحه أينما ظهر، بما في ذلك الفترات السابقة. استخدم هذا للخطأ المطبعي، لا لتغيير حقيقي في الاسم."

msgid "For a renaming, the first day the new name applies. For a correction, any day inside the period being corrected."
msgstr "لإعادة التسمية، أول يوم يسري فيه الاسم الجديد. للتصحيح، أي يوم داخل الفترة التي يجري تصحيحها."

msgid "Save name"
msgstr "حفظ الاسم"

msgid "Enter the date this name applies from."
msgstr "أدخل التاريخ الذي يسري منه هذا الاسم."

msgid "Retire a unit"
msgstr "إيقاف وحدة"

msgid "Retiring closes the unit with an end date. It stops appearing on the tree and in pickers from that day, and every report for an earlier period still resolves through it."
msgstr "الإيقاف يغلق الوحدة بتاريخ انتهاء. تتوقف عن الظهور في الشجرة وفي القوائم من ذلك اليوم، ويظل كل تقرير لفترة سابقة يُحتسب من خلالها."

msgid "Retire from"
msgstr "الإيقاف من"

msgid "The first day the unit no longer applies. The day before is its last."
msgstr "أول يوم لم تعد فيه الوحدة سارية. اليوم السابق له هو آخر أيامها."

msgid "Check what this will do"
msgstr "تحقّق مما سيفعله هذا"

msgid "Retire unit"
msgstr "إيقاف الوحدة"

msgid "What this will do"
msgstr "ما الذي سيفعله هذا"

msgid "{0} will be closed on {1}."
msgstr "ستُغلق {0} في {1}."

msgid "{0} people are still placed here on that date."
msgstr "لا يزال {0} من الأشخاص منسوبين هنا في ذلك التاريخ."

msgid "Nothing is still attached to it on that date."
msgstr "لا شيء مرتبط بها في ذلك التاريخ."

msgid "Yes, retire this unit on the date above."
msgstr "نعم، أوقف هذه الوحدة في التاريخ أعلاه."

msgid "Enter the date this unit closes."
msgstr "أدخل تاريخ إغلاق هذه الوحدة."

msgid "You do not have permission to do that."
msgstr "ليس لديك إذن للقيام بذلك."

msgid "This unit is already placed on this structure. Moving it is a move, not a placement."
msgstr "هذه الوحدة موضوعة بالفعل على هذا الهيكل. نقلها يُعد نقلًا، لا وضعًا."

msgid "The dimension type '{0}' has no attribute called '{1}'."
msgstr "نوع البعد '{0}' لا يحتوي على خاصية باسم '{1}'."

msgid "'{0}' is not a valid value for '{1}'."
msgstr "'{0}' ليست قيمة صالحة لـ '{1}'."

msgid "'{0}' is required."
msgstr "'{0}' مطلوب."

msgid "Dimension record changed"
msgstr "تغيّر سجل البعد"

msgid "A unit was added to a structure, renamed or retired."
msgstr "أُضيفت وحدة إلى هيكل أو أُعيدت تسميتها أو أُوقفت."

# Retiring a unit that still has units under it: the three dispositions, and the unplaced
# panel telling "never placed" apart from "its parent closed under it".

msgid "Units with no parent in this structure on this date. They cannot be reached by expanding the tree."
msgstr "وحدات بلا أصل في هذا الهيكل في هذا التاريخ. لا يمكن الوصول إليها بتوسيع الشجرة."

msgid "Never placed in this structure."
msgstr "لم تُوضع في هذا الهيكل قط."

msgid "Parent retired"
msgstr "أُوقف الأصل"

msgid "{0} closed on {1}."
msgstr "أُغلقت {0} في {1}."

msgid "These sit directly under {0} on its last day. Retiring it leaves them with no parent unless you say otherwise."
msgstr "تقع هذه مباشرةً تحت {0} في آخر أيامها. إيقافها يتركها بلا أصل ما لم تحدد غير ذلك."

msgid "What happens to them?"
msgstr "ما الذي يحدث لها؟"

msgid "Move them to another parent"
msgstr "نقلها إلى أصل آخر"

msgid "They keep everything under them and move across on the same date, so no day passes with them out of the tree."
msgstr "تحتفظ بكل ما تحتها وتنتقل في التاريخ نفسه، فلا يمر يوم واحد وهي خارج الشجرة."

msgid "New parent"
msgstr "الأصل الجديد"

msgid "(top of the structure)"
msgstr "(أعلى الهيكل)"

msgid "Only units this structure's levels allow these to sit under are listed."
msgstr "لا تُعرض إلا الوحدات التي تسمح مستويات هذا الهيكل بوضع هذه تحتها."

msgid "Moving them to another parent needs permission to move dimension records, which you do not have."
msgstr "نقلها إلى أصل آخر يتطلب إذن نقل سجلات الأبعاد، وهو غير متاح لك."

msgid "Retire them as well"
msgstr "إيقافها أيضًا"

msgid "Closes all {0} units in this branch on the same date. Everything before it still resolves."
msgstr "يغلق جميع الوحدات البالغ عددها {0} في هذا الفرع في التاريخ نفسه. ويظل كل ما قبله محتسبًا."

msgid "Show the whole branch"
msgstr "عرض الفرع كاملًا"

msgid "Leave them with no parent"
msgstr "تركها بلا أصل"

msgid "They stay active and move to the unplaced panel, marked as having lost their parent, until somebody places or retires them."
msgstr "تبقى فعّالة وتنتقل إلى لوحة غير المنسوبة، موسومة بأنها فقدت أصلها، إلى أن يضعها أحد أو يوقفها."

msgid "Choose what happens to the units under this one."
msgstr "اختر ما يحدث للوحدات التابعة لهذه الوحدة."

# Stage C: move, merge and cancel move.

msgid "Units under this one on {0}"
msgstr "الوحدات التابعة لهذه الوحدة في {0}"

msgid "{0} units still sit under this one on '{1}' on {2}. Say what should happen to them before retiring it."
msgstr "لا تزال {0} وحدة تقع تحت هذه الوحدة في '{1}' بتاريخ {2}. حدد ما ينبغي أن يحدث لها قبل إيقافها."

msgid "Move to…"
msgstr "نقل إلى…"

msgid "Place under…"
msgstr "وضع تحت…"

msgid "Merge into…"
msgstr "دمج في…"

msgid "Cancel a move…"
msgstr "إلغاء نقل…"

msgid "Move a unit"
msgstr "نقل وحدة"

msgid "Move it under"
msgstr "نقلها لتكون تحت"

msgid "Only units this structure's levels allow this one to sit under are listed."
msgstr "لا تُعرض إلا الوحدات التي تسمح مستويات هذا الهيكل بوضع هذه الوحدة تحتها."

msgid "The first day it sits in the new place. Everything before stays as it was."
msgstr "أول يوم تكون فيه في موضعها الجديد. يبقى كل ما سبق كما هو."

msgid "Now"
msgstr "الآن"

msgid "From {0}"
msgstr "من {0}"

msgid "Not placed on this structure."
msgstr "غير موضوعة على هذا الهيكل."

msgid "No parent: it moves to the unplaced panel."
msgstr "بلا أصل: تنتقل إلى لوحة غير المنسوبة."

msgid "Travelling with it"
msgstr "ينتقل معها"

msgid "{0} units and {1} people."
msgstr "{0} وحدة و{1} من الأشخاص."

msgid "This move is dated inside a later one"
msgstr "هذا النقل مؤرخ داخل نقل لاحق"

msgid "It will apply from {0} to {1} only. The move to {2} already on record stands, and takes over after that."
msgstr "سيسري من {0} إلى {1} فقط. ويبقى النقل إلى {2} المسجّل مسبقًا قائمًا، ويسري بعد ذلك."

msgid "If the later move was the mistake, cancel it rather than dating around it."
msgstr "إذا كان النقل اللاحق هو الخطأ، فألغِه بدلًا من الالتفاف عليه بالتواريخ."

msgid "Yes, move it on the date above."
msgstr "نعم، انقلها في التاريخ أعلاه."

msgid "Move unit"
msgstr "نقل الوحدة"

msgid "Enter the date this move takes effect."
msgstr "أدخل تاريخ سريان هذا النقل."

msgid "Merge a unit into another"
msgstr "دمج وحدة في أخرى"

msgid "Merging {0}"
msgstr "دمج {0}"

msgid "Merge it into"
msgstr "دمجها في"

msgid "Choose a unit"
msgstr "اختر وحدة"

msgid "Units of the same kind, which is what can take over this one's place."
msgstr "وحدات من النوع نفسه، وهي ما يمكن أن يحل محل هذه الوحدة."

msgid "Reports for earlier periods keep resolving through the unit being merged."
msgstr "تظل تقارير الفترات السابقة تُحتسب من خلال الوحدة المدموجة."

msgid "{0} will be retired on {1}."
msgstr "ستُوقف {0} في {1}."

msgid "{0} units move to {1}."
msgstr "تنتقل {0} وحدة إلى {1}."

msgid "{0} people are reassigned to {1}."
msgstr "يُعاد إسناد {0} من الأشخاص إلى {1}."

msgid "Everything before that date still resolves through {0}."
msgstr "يظل كل ما قبل ذلك التاريخ يُحتسب من خلال {0}."

msgid "Show what moves"
msgstr "عرض ما سينتقل"

msgid "Yes, merge it on the date above."
msgstr "نعم، ادمجها في التاريخ أعلاه."

msgid "Merge unit"
msgstr "دمج الوحدة"

msgid "Enter the date this merge takes effect."
msgstr "أدخل تاريخ سريان هذا الدمج."

msgid "Choose the unit to merge into."
msgstr "اختر الوحدة المراد الدمج فيها."

msgid "Cancel a move"
msgstr "إلغاء نقل"

msgid "No moves are recorded for this unit on this structure."
msgstr "لا توجد عمليات نقل مسجّلة لهذه الوحدة على هذا الهيكل."

msgid "Which move"
msgstr "أي نقل"

msgid "Choose a move"
msgstr "اختر نقلًا"

msgid "{0} — under {1}"
msgstr "{0} — تحت {1}"

msgid "The move to {0} on {1} is removed from the record."
msgstr "سيُحذف النقل إلى {0} بتاريخ {1} من السجل."

msgid "Nothing was displaced by it, so the unit will have no parent from that date."
msgstr "لم يُزِح شيئًا، لذا ستبقى الوحدة بلا أصل من ذلك التاريخ."

msgid "The placement it displaced, under {0}, is restored."
msgstr "يُستعاد الموضع الذي أزاحه، تحت {0}."

msgid "{0} people resolve differently as a result."
msgstr "سيتغيّر احتساب {0} من الأشخاص نتيجة لذلك."

msgid "Why is it being cancelled?"
msgstr "لماذا يجري إلغاؤه؟"

msgid "Recorded on the audit trail. A cancellation is never anonymous."
msgstr "يُسجَّل في سجل التدقيق. الإلغاء لا يكون مجهول المصدر أبدًا."

msgid "Yes, cancel this move."
msgstr "نعم، ألغِ هذا النقل."

msgid "Cancel this move"
msgstr "إلغاء هذا النقل"

msgid "Choose the move to cancel."
msgstr "اختر النقل المراد إلغاؤه."

msgid "Say why this move is being cancelled."
msgstr "اذكر سبب إلغاء هذا النقل."

# ---- ADR-0010: containment as an explicit per-structure map ----

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "'{0}' and '{1}' are the same kind of unit, and the structure '{2}' does not allow that kind inside itself."
msgstr "'{0}' و'{1}' من النوع نفسه، والهيكل '{2}' لا يسمح بتداخل هذا النوع داخل نفسه."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "The structure '{0}' does not allow a unit like '{1}' under one like '{2}'."
msgstr "الهيكل '{0}' لا يسمح بوحدة مثل '{1}' تحت وحدة مثل '{2}'."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "'{0}' is named in this structure's rules but is not one of its types."
msgstr "'{0}' مذكور في قواعد هذا الهيكل لكنه ليس من أنواعه."

#: WorkMate.Dimensions.Internal.Graph.DimensionValidator
msgid "A structure needs at least one kind of unit that may sit at its top."
msgstr "يحتاج الهيكل إلى نوع واحد على الأقل من الوحدات يمكن أن يكون في قمته."

#: WorkMate.Dimensions.Internal.Graph.DimensionGraphService
