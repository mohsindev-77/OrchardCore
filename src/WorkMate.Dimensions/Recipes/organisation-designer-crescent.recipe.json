{
  "name": "WorkMate.Demo.Crescent",
  "displayName": "WorkMate demo: Crescent Microfinance",
  "description": "TEST DATA — a microfinance lender with a head office and a branch network, as a worked example of a ragged tree. One Division holds Departments directly while its sibling holds Regions, and Departments appear again three levels further down under a Branch. Self-contained: every code is prefixed crescent-, so it adds to a tenant without colliding with the other demo recipes and can be applied in any order alongside them.",
  "author": "Aramis Enterprise Solutions",
  "version": "0.1.0",
  "issetuprecipe": false,
  "categories": ["workmate", "demo"],
  "tags": ["workmate", "demo", "test-data"],

  "$notes": [
    "The shape this exists to demonstrate: depth is not uniform. Head Office > Credit Risk is two levels deep; Branch Network > Punjab Region > Lahore Main Branch > Credit is four. The same Department type is reachable at both, which a chain of level ordinals cannot express at all.",
    "Two branches have no departments under them. A leaf at depth three beside a sibling that goes one deeper is the ordinary case for a branch network, not an edge case.",
    "Department codes carry the branch they belong to — crescent-dept-lhr-credit, crescent-dept-khi-credit — because a code is unique across the whole tenant, not within a parent. Two branches each having a 'Credit' department is exactly where that bites.",
    "Branch carries a real attribute schema — location, cost centre, branch code — and every branch carries values for it. Both halves travel through export and import since ADR-0011."
  ],

  "steps": [
    {
      "name": "dimension-types",
      "types": [
        { "code": "crescent-division", "nameEn": "Division", "nameAr": "قطاع", "allowsSelfNesting": false },
        { "code": "crescent-department", "nameEn": "Department", "nameAr": "إدارة", "allowsSelfNesting": false },
        { "code": "crescent-region", "nameEn": "Region", "nameAr": "منطقة", "allowsSelfNesting": false },
        {
          "code": "crescent-branch",
          "nameEn": "Branch",
          "nameAr": "فرع",
          "allowsSelfNesting": false,
          "attributes": [
            { "name": "Location", "labelEn": "Location", "labelAr": "الموقع", "kind": "Text", "isRequired": true },
            { "name": "CostCentre", "labelEn": "Cost centre", "labelAr": "مركز التكلفة", "kind": "Text", "isRequired": true },
            { "name": "BranchCode", "labelEn": "Branch code", "labelAr": "رمز الفرع", "kind": "Text", "isRequired": true }
          ]
        }
      ]
    },

