      "name": "dimension-types",
      "types": [
        { "code": "zenith-division", "nameEn": "Division", "nameAr": "قطاع", "allowsSelfNesting": false },
        { "code": "zenith-department", "nameEn": "Department", "nameAr": "إدارة", "allowsSelfNesting": false },
        {
          "code": "zenith-project",
          "nameEn": "Project",
          "nameAr": "مشروع",
          "allowsSelfNesting": false,
          "attributes": [
            { "name": "StartDate", "labelEn": "Start date", "labelAr": "تاريخ البدء", "kind": "Date", "isRequired": true },
            { "name": "EndDate", "labelEn": "End date", "labelAr": "تاريخ الانتهاء", "kind": "Date", "isRequired": false },
            { "name": "CostCode", "labelEn": "Cost code", "labelAr": "رمز التكلفة", "kind": "Text", "isRequired": true },
            { "name": "SiteLocation", "labelEn": "Site location", "labelAr": "موقع العمل", "kind": "Text", "isRequired": false }
          ]
